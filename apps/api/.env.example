# Flirty Greece API
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Database
DATABASE_URL=postgresql://flirty:flirty_dev@localhost:5432/flirty_greece?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (must be >= 32 chars in production)
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/uploads
# S3-compatible (MinIO / R2 / AWS) — required when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=flirty-greece
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Billing (dev | stripe)
BILLING_PROVIDER=dev
BILLING_WEBHOOK_SECRET=dev_webhook_secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_GOLD=
STRIPE_PRICE_PLATINUM=
STRIPE_PRICE_SUPERLIKES5=
STRIPE_PRICE_BOOST=
STRIPE_PRICE_FIRST_MESSAGE=
STRIPE_PRICE_SPOTLIGHT=

# App
APP_NAME=Flirty Greece
APP_URL=http://localhost:3001
MIN_AGE=18

# Seed safety — never set in production
# ALLOW_UNSAFE_SEED=1
